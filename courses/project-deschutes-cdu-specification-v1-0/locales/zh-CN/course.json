  "term_glossary": [
    {
      "id": "dlc",
      "term": "DLC",
      "tooltip": "直接液冷通过冷板和专用冷却回路在芯片或服务器层面去除热量。"
    },
    {
      "id": "cdu",
      "term": "CDU",
      "tooltip": "冷却液分配单元：控制冷却剂流量、压力和热量传递的液体间桥，控制设施水与IT设备之间的热量传递。"
    },
    {
      "id": "fws",
      "term": "FWS",
      "tooltip": "设施水系统：建筑物侧的冷水或冷凝水回路，向CDU主侧供水。"
    },
    {
      "id": "tcs",
      "term": "TCS",
      "tooltip": "技术冷却系统：为rack歧管和冷板提供清洁的二次冷却液回路。"
    },
    {
      "id": "approach_temperature",
      "term": "接近温差",
      "tooltip": "冷TCS水流出CDU与冷水FWS水流的差异;Deschutes目标温度为3°C。"
    },
    {
      "id": "differential_pressure",
      "term": "dP",
      "tooltip": "压差：用于推动冷却液通过歧管、软管和冷板的压力头。"
    },
    {
      "id": "heat_exchanger",
      "term": "HX",
      "tooltip": "换热器：在循环之间传递热量而不混合设施和IT冷却液。"
    },
    {
      "id": "di_water",
      "term": "去离水",
      "tooltip": "去离子水：经过处理以去除可能影响腐蚀或导电性的溶解离子的水。"
    },
    {
      "id": "pg25",
      "term": "PG25",
      "tooltip": "丙二醇冷却液混合物，乙二醇浓度约为25%。"
    },
    {
      "id": "epdm",
      "term": "EPDM",
      "tooltip": "乙烯、丙烯二烯单体：用于冷却剂兼容软管和密封件的弹性体。"
    },
    {
      "id": "vfd",
      "term": "VFD",
      "tooltip": "变频器：控制电机转速，此处用于泵转速控制和效率。"
    },
    {
      "id": "plc",
      "term": "PLC",
      "tooltip": "可编程逻辑控制器：工业控制器，运行CDU控制环路、报警和接口。"
    },
    {
      "id": "modbus_tcp",
      "term": "Modbus/TCP",
      "tooltip": "工业通信协议，通过标准TCP/IP网络传输Modbus消息。"
    },
    {
      "id": "ipv6_dual_stack",
      "term": "IPv6 双栈",
      "tooltip": "同时支持IPv4和IPv6网络支持。"
    },
    {
      "id": "hac",
      "term": "HAC",
      "tooltip": "热通道封闭：管理rack排周围热排气的结构。"
    },
    {
      "id": "rdhx",
      "term": "RDHx",
      "tooltip": "后门换热器：Redmond通道尺寸中提及的rack后门冷却装置。"
    },
    {
      "id": "four_makes_three",
