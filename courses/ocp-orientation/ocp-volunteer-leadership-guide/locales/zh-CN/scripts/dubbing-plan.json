          "cue": 1,
          "start_seconds": 0.3,
          "end_seconds": 3.003,
          "recommended_spoken_text": "OCP 是活跃的社区，"
        },
        {
          "cue": 2,
          "start_seconds": 3.003,
          "end_seconds": 6.006,
          "recommended_spoken_text": "遍及全球数据中心领域。"
        },
        {
          "cue": 3,
          "start_seconds": 6.673,
          "end_seconds": 11.077,
          "recommended_spoken_text": "虽非标准组织，仍促成新技术惯例，"
        },
        {
          "cue": 4,
          "start_seconds": 11.077,
          "end_seconds": 15.348,
          "recommended_spoken_text": "让产业伙伴在安全架构下协作，"
        },
        {
          "cue": 5,
          "start_seconds": 15.348,
          "end_seconds": 19.352,
          "recommended_spoken_text": "形成灵活多元的供应链。"
        },
        {
          "cue": 6,
          "start_seconds": 19.352,
          "end_seconds": 23.79,
          "recommended_spoken_text": "从新创、大型业者，到研究、学术与投资者，"
        },
        {
          "cue": 7,
          "start_seconds": 23.923,
          "end_seconds": 28.561,
          "recommended_spoken_text": "OCP 能缩短采购与研究时间，"
        },
        {
          "cue": 8,
          "start_seconds": 28.762,
          "end_seconds": 33.333,
          "recommended_spoken_text": "减少费用、开发时间与法律复杂度。"
        },
        {
          "cue": 9,
          "start_seconds": 33.9,
          "end_seconds": 35.969,
          "recommended_spoken_text": "参与 OCP，"
        },
        {
          "cue": 10,
          "start_seconds": 35.969,
          "end_seconds": 38.972,
          "recommended_spoken_text": "接触新技术与人才，"
        },
        {
          "cue": 11,
          "start_seconds": 38.972,
          "end_seconds": 42.609,
          "recommended_spoken_text": "增进技能，在重要领域发挥影响，"
        },
        {
          "cue": 12,
          "start_seconds": 42.609,
          "end_seconds": 45.945,
          "recommended_spoken_text": "例如能效、冷却与永续。"
