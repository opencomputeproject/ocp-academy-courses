        {
          "cue": 24,
          "start_seconds": 88.321,
          "end_seconds": 91.724,
          "recommended_spoken_text": "重大挑戰，建立品牌信任。"
        },
        {
          "cue": 25,
          "start_seconds": 92.19200000000001,
          "end_seconds": 95.595,
          "recommended_spoken_text": "參加或贊助 OCP 活動交流，"
        },
        {
          "cue": 26,
          "start_seconds": 95.762,
          "end_seconds": 98.765,
          "recommended_spoken_text": "展現包容與開放精神。"
        },
