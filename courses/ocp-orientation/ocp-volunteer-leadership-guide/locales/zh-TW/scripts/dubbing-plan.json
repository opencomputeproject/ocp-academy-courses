          "start_seconds": 0.266,
          "end_seconds": 5.238,
          "recommended_spoken_text": "OCP 重新構想資料中心、電信與邊緣基礎設施，"
        },
        {
          "cue": 2,
          "start_seconds": 5.372,
          "end_seconds": 8.608,
          "recommended_spoken_text": "帶來更多選擇、客製化與節省。"
        },
        {
          "cue": 3,
          "start_seconds": 8.675,
          "end_seconds": 13.813,
          "recommended_spoken_text": "解決方案供應商，是實現使命的重要力量。"
        },
        {
          "cue": 4,
          "start_seconds": 13.947,
          "end_seconds": 17.117,
          "recommended_spoken_text": "他們交付並支援整合方案，"
        },
        {
          "cue": 5,
          "start_seconds": 17.283,
          "end_seconds": 21.021,
          "recommended_spoken_text": "提供在地工程與架構資源，"
        },
        {
          "cue": 6,
          "start_seconds": 21.021,
          "end_seconds": 24.958,
          "recommended_spoken_text": "與 OCP 製造商維持合作，"
        },
        {
          "cue": 7,
          "start_seconds": 24.991,
          "end_seconds": 29.029,
          "recommended_spoken_text": "參與基金會的業務規劃，"
        },
        {
          "cue": 8,
          "start_seconds": 29.029,
          "end_seconds": 30.23,
          "recommended_spoken_text": "配合目標，"
