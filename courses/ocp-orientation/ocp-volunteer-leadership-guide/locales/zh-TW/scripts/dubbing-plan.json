          "recommended_spoken_text": "先成為 OCP 企業會員，"
        },
        {
          "cue": 12,
          "start_seconds": 39.806,
          "end_seconds": 43.576,
          "recommended_spoken_text": "簽署適用協議，繳交費用。"
        },
        {
          "cue": 13,
          "start_seconds": 43.71,
          "end_seconds": 44.911,
          "recommended_spoken_text": "接著打造，"
        },
        {
          "cue": 14,
          "start_seconds": 44.911,
          "end_seconds": 49.049,
          "recommended_spoken_text": "以核准規格或設計套件為基礎的產品。"
        },
        {
          "cue": 15,
          "start_seconds": 49.215,
          "end_seconds": 51.251,
          "recommended_spoken_text": "若提供共置服務，"
        },
        {
          "cue": 16,
          "start_seconds": 51.251,
          "end_seconds": 54.187,
          "recommended_spoken_text": "請完成 OCP Ready 場地評估。"
        },
        {
          "cue": 17,
          "start_seconds": 54.254,
          "end_seconds": 59.325,
          "recommended_spoken_text": "完成後，可以申請產品認可，"
        },
        {
          "cue": 18,
          "start_seconds": 59.325,
          "end_seconds": 64.23,
          "recommended_spoken_text": "取得 OCP Accepted 核准；或將場地評估，"
        },
        {
          "cue": 19,
          "start_seconds": 64.23,
          "end_seconds": 68.668,
          "recommended_spoken_text": "提交孵化委員會，申請 OCP Ready 認可。"
        },
        {
          "cue": 20,
          "start_seconds": 68.968,
          "end_seconds": 72.672,
          "recommended_spoken_text": "產品、方案或設施核准後，"
        },
        {
          "cue": 21,
          "start_seconds": 72.872,
          "end_seconds": 77.61,
          "recommended_spoken_text": "便能推廣 OCP Accepted 產品與整合方案，"
        },
        {
          "cue": 22,
          "start_seconds": 77.777,
          "end_seconds": 81.91499999999999,
          "recommended_spoken_text": "或 OCP Ready 設施，透過 Marketplace 接觸全球。"
        },
        {
          "cue": 23,
          "start_seconds": 82.248,
          "end_seconds": 85.752,
          "recommended_spoken_text": "以供應商身分參與 OCP，"
        },
        {
          "cue": 24,
          "start_seconds": 85.952,
          "end_seconds": 88.788,
          "recommended_spoken_text": "協助客戶提升效率，"
        },
        {
          "cue": 25,
          "start_seconds": 88.788,
