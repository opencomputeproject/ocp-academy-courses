        {
          "cue": 1,
          "start_seconds": 0.3,
          "end_seconds": 3.003,
          "recommended_spoken_text": "OCP 是活躍的社群，"
        },
        {
          "cue": 2,
          "start_seconds": 3.003,
          "end_seconds": 6.006,
          "recommended_spoken_text": "遍及全球資料中心領域。"
        },
        {
          "cue": 3,
          "start_seconds": 6.673,
          "end_seconds": 11.077,
          "recommended_spoken_text": "雖非標準組織，仍促成新技術慣例，"
        },
        {
          "cue": 4,
          "start_seconds": 11.077,
          "end_seconds": 15.348,
          "recommended_spoken_text": "讓產業夥伴在安全架構下協作，"
        },
        {
          "cue": 5,
          "start_seconds": 15.348,
          "end_seconds": 19.352,
          "recommended_spoken_text": "形成靈活多元的供應鏈。"
        },
        {
          "cue": 6,
          "start_seconds": 19.352,
          "end_seconds": 23.79,
          "recommended_spoken_text": "從新創、大型業者，到研究、學術與投資者，"
        },
        {
          "cue": 7,
          "start_seconds": 23.923,
          "end_seconds": 28.561,
          "recommended_spoken_text": "OCP 能縮短採購與研究時間，"
        },
        {
          "cue": 8,
          "start_seconds": 28.762,
          "end_seconds": 33.333,
          "recommended_spoken_text": "減少費用、開發時間與法律複雜度。"
        },
        {
          "cue": 9,
          "start_seconds": 33.9,
          "end_seconds": 35.969,
          "recommended_spoken_text": "參與 OCP，"
        },
        {
          "cue": 10,
          "start_seconds": 35.969,
          "end_seconds": 38.972,
          "recommended_spoken_text": "接觸新技術與人才，"
        },
        {
          "cue": 11,
          "start_seconds": 38.972,
          "end_seconds": 42.609,
          "recommended_spoken_text": "增進技能，在重要領域發揮影響，"
        },
        {
          "cue": 12,
          "start_seconds": 42.609,
          "end_seconds": 45.945,
          "recommended_spoken_text": "例如能效、冷卻與永續。"
        },
        {
          "cue": 13,
          "start_seconds": 46.513,
          "end_seconds": 49.516,
          "recommended_spoken_text": "加入工作小組，解決挑戰，"
        },
        {
          "cue": 14,
          "start_seconds": 49.516,
          "end_seconds": 53.286,
          "recommended_spoken_text": "開創方案，或擔任志工領導者，"
        },
        {
          "cue": 15,
          "start_seconds": 53.386,
          "end_seconds": 57.257,
          "recommended_spoken_text": "引導社群回應更多產業挑戰。"
        },
        {
          "cue": 16,
          "start_seconds": 57.657,
          "end_seconds": 61.127,
          "recommended_spoken_text": "尋找新方案，請探索 Marketplace，"
        },
        {
          "cue": 17,
          "start_seconds": 61.127,
          "end_seconds": 64.23,
          "recommended_spoken_text": "或規格與貢獻資料庫，"
        },
        {
          "cue": 18,
          "start_seconds": 64.431,
          "end_seconds": 67.56700000000001,
          "recommended_spoken_text": "在下一項工作採用 OCP，"
        },
        {
          "cue": 19,
          "start_seconds": 67.801,
          "end_seconds": 71.604,
          "recommended_spoken_text": "或將規格納入提案徵求書。"
        },
        {
          "cue": 20,
          "start_seconds": 72.005,
          "end_seconds": 76.443,
          "recommended_spoken_text": "到 OCP 體驗中心查看最新方案，"
        },
        {
          "cue": 21,
          "start_seconds": 76.443,
          "end_seconds": 81.281,
          "recommended_spoken_text": "或與認可設施及解決方案供應商合作。"
        },
        {
          "cue": 22,
          "start_seconds": 81.581,
          "end_seconds": 86.05199999999999,
          "recommended_spoken_text": "貢獻規格、設計檔案、參考架構，"
        },
        {
          "cue": 23,
          "start_seconds": 86.05199999999999,
          "end_seconds": 88.321,
          "recommended_spoken_text": "或軟體，共同解決，"
