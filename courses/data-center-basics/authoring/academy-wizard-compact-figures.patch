+// Inspect authored static SVG ink bounds. Apply only substantial outer-canvas trims.
+// Usage: node fit_svg_artboards.mjs course.json [--apply] [--margin 24] [--min-trim 96] [--report file.json]
+import {chromium} from 'playwright';import fs from 'node:fs/promises';import path from 'node:path';import {pathToFileURL} from 'node:url';
+const args=process.argv.slice(2),input=args.shift();if(!input)throw Error('Provide course.json');const apply=args.includes('--apply');function option(name,fallback){const i=args.indexOf(name);return i<0?fallback:args[i+1]}const margin=Number(option('--margin',24)),minimum=Number(option('--min-trim',96)),reportPath=option('--report','');if(!Number.isFinite(margin)||margin<0||!Number.isFinite(minimum)||minimum<0)throw Error('Invalid margin or minimum trim');const coursePath=path.resolve(input),root=path.dirname(coursePath),course=JSON.parse(await fs.readFile(coursePath));if(!Array.isArray(course.modules))throw Error('This audit supports Slides module figures; inspect Scrolling SVG assets directly.');const rows=course.modules.flatMap(m=>m.slides.filter(s=>s.figure?.path?.toLowerCase().endsWith('.svg')&&s.figure.source==='custom'&&s.figure.media_type!=='video').map(s=>({module:m.id,slide:s.id,path:s.figure.path})));const browser=await chromium.launch({headless:true,args:['--mute-audio']});const page=await browser.newPage({viewport:{width:1200,height:675}});const records=[];
+try{for(const row of rows){const file=path.join(root,row.path);await page.goto(pathToFileURL(file).href);await page.evaluate(()=>document.fonts.ready);const result=await page.evaluate(({margin,minimum,apply})=>{const svg=document.documentElement,v=svg.viewBox.baseVal;const old={x:v.x,y:v.y,width:v.width,height:v.height};const toRoot=svg.getScreenCTM().inverse();const bounds=[],backgrounds=[];
+for(const e of svg.querySelectorAll('rect,path,polygon,polyline,line,circle,ellipse,text,image,use')){if(e.closest('defs,clipPath,mask,marker,symbol'))continue;const c=getComputedStyle(e);let visible=true;for(let p=e;p&&p instanceof Element;p=p.parentElement){const s=getComputedStyle(p);if(s.display==='none'||s.visibility==='hidden'||+s.opacity===0){visible=false;break}}if(!visible||(c.fill==='none'&&c.stroke==='none')||(e.localName==='text'&&!e.textContent.trim()))continue;const b=e.getBBox();if(!b.width&&!b.height)continue;const isBackground=e.localName==='rect'&&Math.abs(b.x-v.x)<.1&&Math.abs(b.y-v.y)<.1&&Math.abs(b.width-v.width)<.1&&Math.abs(b.height-v.height)<.1&&c.stroke==='none'&&c.fill==='rgb(255, 255, 255)';if(isBackground){backgrounds.push(e);continue}const matrix=toRoot.multiply(e.getScreenCTM()),points=[[b.x,b.y],[b.x+b.width,b.y],[b.x,b.y+b.height],[b.x+b.width,b.y+b.height]].map(([x,y])=>new DOMPoint(x,y).matrixTransform(matrix));const stroke=c.stroke==='none'?0:parseFloat(c.strokeWidth)/2;bounds.push({left:Math.min(...points.map(p=>p.x))-stroke,right:Math.max(...points.map(p=>p.x))+stroke,top:Math.min(...points.map(p=>p.y))-stroke,bottom:Math.max(...points.map(p=>p.y))+stroke})}
+if(!bounds.length)return{old,changed:false,reason:'No measurable artwork'};const art={left:Math.min(...bounds.map(b=>b.left)),right:Math.max(...bounds.map(b=>b.right)),top:Math.min(...bounds.map(b=>b.top)),bottom:Math.max(...bounds.map(b=>b.bottom))};const top=Math.floor((art.top-margin)*100)/100,bottom=Math.ceil((art.bottom+margin)*100)/100,newHeight=Number((bottom-top).toFixed(2)),removed=old.height-newHeight;const shouldTrim=removed>=minimum;const next=shouldTrim?{x:old.x,y:top,width:old.width,height:newHeight}:old;let source=null;if(shouldTrim&&apply){svg.setAttribute('viewBox',`${next.x} ${next.y} ${next.width} ${next.height}`);svg.setAttribute('width',String(next.width));svg.setAttribute('height',String(next.height));for(const bg of backgrounds){bg.setAttribute('x',String(next.x));bg.setAttribute('y',String(next.y));bg.setAttribute('width',String(next.width));bg.setAttribute('height',String(next.height))}source=new XMLSerializer().serializeToString(svg)}return{old,art,padding:{top:art.top-old.y,bottom:old.y+old.height-art.bottom},suggested:next,removedHeight:shouldTrim?removed:0,changed:shouldTrim,source}}, {margin,minimum,apply});
+const {source,...record}=result;if(source)await fs.writeFile(file,source+'\n');records.push({...row,...record});console.log(`${apply&&result.changed?'FITTED':'AUDITED'} M${row.module}S${row.slide}: ${result.old.height} → ${result.suggested?.height??result.old.height}`)}
+}finally{await browser.close()}const report={mode:apply?'apply':'read-only',axis:'vertical; horizontal scale and geometry retained',margin,minimumTrim:minimum,figures:records.length,changed:records.filter(r=>r.changed).length,records};if(reportPath)await fs.writeFile(path.resolve(reportPath),JSON.stringify(report,null,2)+'\n');console.log(`${report.figures} figures; ${report.changed} ${apply?'fitted':'proposed trims'}`);
