      }
    },
    {
      "module": 5,
      "slide": 2,
      "removed_subtitle": "Original course contributor: Seema Mehta, CTO at Intel Labs.",
      "removed_module_credit": "Seema Mehta, CTO at Intel Labs",
      "removed_spoken_acknowledgement": "We recognize Seema Mehta at Intel Labs for technical guidance during the original course series. The contributor title shown here preserves the original course credit.",
      "new_script": "By the end of this module, you'll be able to explain why a successful deployment does not automatically produce a plug-compatible ecosystem. You'll identify the information that must cross organizational boundaries and the role of shared models in making that information useful. You'll also choose a concrete next step for participating in the community.",
      "audio": {
