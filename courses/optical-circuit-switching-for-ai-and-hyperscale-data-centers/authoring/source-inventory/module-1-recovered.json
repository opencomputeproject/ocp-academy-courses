            "marker_color_contrast": "AUTO",
            "entrance_animation": true
          },
          "image_role": "decorative",
          "media": {
            "path": "resources/images/why-4.png",
            "alt": "Why_4.png",
            "source_asset": "Why_4.png",
            "mime_type": "image/png",
            "bytes": 9256,
            "dimensions": {
              "originalWidth": 1680,
              "originalHeight": 222
            }
          }
        },
        {
          "id": 2,
          "type": "text",
          "variant": "paragraph",
          "style": {
            "background_type": "COLOR",
            "background_color": "#f1f1f1",
            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 3,
            "marker_color_contrast": "AUTO"
          },
          "body_html": "<p>The transition from traditional electrical routing to pure <strong>optical switching</strong> introduces a highly specialized architectural vocabulary. Understanding the exact definitions of concepts like <strong>optical insertion loss</strong>, <strong>data-rate-agnostic operation</strong>, and <strong>OEO conversion</strong> is critical for evaluating real world network designs.</p><p>Explore the flashcards below to connect these physical constraints directly to the broader shift toward <strong>optical infrastructure</strong>.</p>"
        },
        {
          "id": 3,
          "type": "flashcards",
          "variant": "flashcard",
          "style": {
            "background_type": "IMAGE",
            "card_mode": "WHITE",
            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 3,
            "marker_color_contrast": "AUTO",
            "background_media": {
              "path": "resources/images/ocp-2-26-sb02-m6v2-3a-4a-a-1.jpg",
              "alt": "OCP 2.26_SB02_M6V2_3A-4A.ai.png",
              "source_asset": "OCP 2.26_SB02_M6V2_3A-4A.a-1.jpg",
              "mime_type": "image/jpeg",
              "bytes": 154496,
