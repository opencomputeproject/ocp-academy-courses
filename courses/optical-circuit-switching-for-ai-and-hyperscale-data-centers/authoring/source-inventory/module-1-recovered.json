          }
        },
        {
          "id": 2,
          "type": "text",
          "variant": "paragraph",
          "style": {
            "background_type": "COLOR",
            "background_color": "#1c1c1c",
            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 3,
            "marker_color_contrast": "AUTO"
          },
          "body_html": "<p><span style=\"font-size: 1.6rem\"><strong>Modern artificial intelligence workloads</strong> are overwhelming traditional <strong>EPS-based data center fabrics</strong>. Networks face unprecedented demands for <strong>power consumption</strong>, <strong>latency</strong>, and <strong>scalability</strong>.</span></p><p><span style=\"font-size: 1.6rem\">The following video introduces <strong>direct photonic connections</strong> and explains why eliminating <strong>Optical-Electrical-Optical (OEO)</strong> conversion is the architectural solution.</span></p>"
        },
        {
          "id": 3,
          "type": "video",
          "variant": "video",
          "style": {
            "background_type": "COLOR",
            "background_color": "#1c1c1c",
            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 3,
            "marker_color_contrast": "AUTO"
          },
          "media": {
