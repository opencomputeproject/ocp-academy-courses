            "source_asset": "ocs_m1v1_-_introduction_to.mp4",
            "mime_type": "video/mp4",
            "bytes": 31118944,
            "duration_seconds": 185,
            "poster": "resources/images/ocs-m1v1-introduction-to.jpg",
            "captions": [
              {
                "path": "resources/captions/ai-captions-1791258047355.vtt",
