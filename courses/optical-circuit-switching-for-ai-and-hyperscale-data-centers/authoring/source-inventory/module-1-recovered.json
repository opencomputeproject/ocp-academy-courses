                "label": "English (US)"
              }
            ]
          }
        },
        {
          "id": 4,
          "type": "text",
          "variant": "subheading",
          "style": {
            "background_type": "COLOR",
            "background_color": "#1c1c1c",
            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 0,
            "marker_color_contrast": "AUTO"
          },
          "heading_html": "<p>Understanding the high-level bottleneck is the first step. </p><p>Next, we will dive into the exact <span style=\"color: #8cc53f; text-decoration: inherit\" data-color-scope=\"inner\">operating principles</span> that allow OCS to function <span style=\"color: #8cc53f; text-decoration: inherit\" data-color-scope=\"inner\">purely in the optical domain</span>.</p>"
