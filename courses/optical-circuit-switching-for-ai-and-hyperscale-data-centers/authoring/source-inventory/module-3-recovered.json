      "id": 5,
      "slug": "hardware-failure-resiliency",
      "title": "Hardware Failure Resiliency",
      "description_html": "",
      "blocks": [
        {
          "id": 1,
          "type": "image",
          "variant": "full",
          "style": {
            "background_type": "LIGHT",
            "card_mode": "WHITE",
            "image_opacity": 0.5,
