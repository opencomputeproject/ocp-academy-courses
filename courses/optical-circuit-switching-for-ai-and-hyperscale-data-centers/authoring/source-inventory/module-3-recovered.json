            "source_asset": "ocs_m3v2_-_hardware_failur.mp4",
            "mime_type": "video/mp4",
            "bytes": 38450116,
            "duration_seconds": 169,
            "poster": "resources/images/ocs-m3v2-hardware-failur.jpg",
