            "attached_to_next": false,
            "padding_top": 3,
            "padding_bottom": 0,
            "marker_color_contrast": "AUTO"
          },
          "heading_html": "<p>Before we look ahead to emerging frontier technologies, apply your understanding of spine replacement, dynamic topologies, and hardware resiliency.</p>"
        },
