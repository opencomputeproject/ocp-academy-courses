      {
        "text": "uma fixação traseira.",
        "at_seconds": 0.0
      },
      {
        "text": "A vista lateral revela o apoio que a vista frontal oculta.",
        "at_seconds": 0.0
      },
      {
        "text": "Mesmas orelhas frontais",
        "at_seconds": 17.292
      },
      {
        "text": "O trilho traseiro estendido",
