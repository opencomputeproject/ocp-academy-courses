    "sha256": "1d2dc5fc36bd2f6991e18de8aa0e282cfe8b1739ffadfa0629c9b5f4873583b2",
    "entries": [
      {
        "text": "장비 예시 / 측면도",
        "at_seconds": 0.0
      },
      {
        "text": "전후방 지지대",
        "at_seconds": 0.0
      },
      {
        "text": "전면에서 장착 귀를 고정합니다.",
        "at_seconds": 0.0
      },
      {
        "text": "이 장비에는 뒤쪽",
        "at_seconds": 0.0
      },
      {
        "text": "체결부도 있습니다.",
        "at_seconds": 0.0
      },
      {
        "text": "정면도에 가려진 지지부가 측면도에 보입니다.",
        "at_seconds": 0.0
      },
      {
        "text": "같은 전면 장착 귀",
        "at_seconds": 16.917
      },
      {
        "text": "연장 레일은 더 뒤에",
        "at_seconds": 16.917
      },
      {
        "text": "있습니다. 장비의 뒤쪽",
        "at_seconds": 16.917
      },
      {
        "text": "체결부가 닿아야 합니다.",
        "at_seconds": 16.917
      },
      {
        "text": "점선: 다른 후면 레일 위치.",
        "at_seconds": 16.917
      },
      {
        "text": "전면 장착 예시",
        "at_seconds": 27.25
      },
      {
        "text": "뒤쪽 지지는 장비마다",
        "at_seconds": 27.25
      },
      {
        "text": "다릅니다. 이 예에는",
        "at_seconds": 27.25
      },
      {
        "text": "앞쪽 장착 귀만 있습니다.",
        "at_seconds": 27.25
      },
      {
        "text": "장비에 지정된 장착 방식을 사용합니다.",
        "at_seconds": 27.25
      },
      {
        "text": "서로 다른 두 질문",
        "at_seconds": 36.583
      },
      {
        "text": "어떻게 장착할까?",
        "at_seconds": 36.583
      },
      {
        "text": "어떻게 급전할까?",
        "at_seconds": 36.583
      },
      {
        "text": "장착 귀와 지지대를",
        "at_seconds": 36.583
      },
      {
        "text": "설치된 키트에 맞춥니다.",
        "at_seconds": 36.583
      },
      {
        "text": "장비 입력구를 의도한",
        "at_seconds": 36.583
      },
      {
        "text": "전원에 맞춥니다.",
        "at_seconds": 36.583
      }
    ]
  },
  "compressed_labels": {
    "to the installed kit.": 0.987
  },
