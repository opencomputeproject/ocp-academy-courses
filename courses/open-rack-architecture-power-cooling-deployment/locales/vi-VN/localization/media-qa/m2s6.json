    "entries": [
      {
        "text": "VÍ DỤ THIẾT BỊ / HÌNH CHIẾU BÊN",
        "at_seconds": 0.0
      },
      {
        "text": "Điểm đỡ trước và sau",
        "at_seconds": 0.0
      },
      {
        "text": "Tai gá bắt ở phía trước.",
        "at_seconds": 0.0
      },
      {
        "text": "Thiết bị này còn có",
        "at_seconds": 0.0
      },
      {
        "text": "điểm gá phía sau.",
        "at_seconds": 0.0
      },
      {
        "text": "Hình chiếu bên cho thấy điểm đỡ bị khuất khi nhìn từ trước.",
        "at_seconds": 0.0
      },
      {
        "text": "Tai gá trước không đổi",
        "at_seconds": 16.042
      },
      {
        "text": "Với ray kéo dài, ray sau",
        "at_seconds": 16.042
      },
      {
        "text": "nằm xa hơn. Điểm gá sau",
        "at_seconds": 16.042
      },
      {
        "text": "của thiết bị phải với tới.",
        "at_seconds": 16.042
      },
      {
        "text": "Nét đứt: vị trí ray sau của cấu hình khác.",
        "at_seconds": 16.042
      },
      {
        "text": "Ví dụ chỉ gá phía trước",
        "at_seconds": 25.417
      },
      {
        "text": "Điểm đỡ sau tùy thiết bị.",
        "at_seconds": 25.417
      },
      {
        "text": "Ở đây thiết bị chỉ có",
        "at_seconds": 25.417
      },
      {
        "text": "tai gá phía trước.",
        "at_seconds": 25.417
      },
      {
        "text": "Dùng cách gá lắp theo quy định cho thiết bị.",
        "at_seconds": 25.417
      },
      {
        "text": "HAI CÂU HỎI KHÁC NHAU",
        "at_seconds": 34.792
      },
      {
        "text": "Lắp thiết bị thế nào?",
        "at_seconds": 34.792
      },
      {
        "text": "Thiết bị lấy điện từ đâu?",
        "at_seconds": 34.792
      },
      {
        "text": "Tai gá và điểm đỡ phải",
        "at_seconds": 34.792
      },
      {
        "text": "phù hợp với bộ gá đã lắp.",
        "at_seconds": 34.792
      },
      {
        "text": "Đầu vào nguồn phải khớp",
        "at_seconds": 34.792
      },
      {
        "text": "với nguồn cấp dự kiến.",
        "at_seconds": 34.792
      }
    ]
  },
